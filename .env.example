# Model protocol: deepseek, openai (Chat Completions), or anthropic (Messages)
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Leave empty to use the selected provider's default URL and model.
LLM_BASE_URL=
LLM_MODEL=
# Optional display name, shown in the reader (never put a key here).
LLM_DISPLAY_NAME=
# Empty = provider/model default. Set only a level supported by your model.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=5000
# DeepSeek: enabled / disabled. Claude: adaptive / enabled / disabled.
# For OpenAI-compatible APIs leave empty; use LLM_REASONING_EFFORT instead.
LLM_THINKING=
LLM_THINKING_BUDGET=2048

# Legacy DeepSeek settings remain supported when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
